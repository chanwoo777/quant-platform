# Copy to .env and adjust. Every value is optional; defaults are shown.
# No API keys are needed anywhere: all sources are free and public.

# --- Storage ---------------------------------------------------------------
# SQLite file in ./data by default. For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/quant
# DATABASE_URL=sqlite:///data/quant.db

# --- Universe ----------------------------------------------------------------
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,JPM,XOM,JNJ,TSLA
BENCHMARKS=^GSPC,^IXIC,^DJI,^RUT,^VIX,SPY
# Research universe for factor tests and backtests: "watchlist" (the names above) or
# "sp500" (point-in-time S&P 500 members: ~600 more tickers, daily prices + SEC filings).
# The live paper portfolio, signals and dashboard always use the watchlist.
RESEARCH_UNIVERSE=watchlist
# Headlines + FinBERT: "watchlist" only, or "research" to add the research universe (slow).
NEWS_UNIVERSE=watchlist

# --- Market data (Yahoo Finance via yfinance) ---------------------------------
DAILY_HISTORY_PERIOD=10y
INTRADAY_INTERVAL=15m
# Yahoo keeps 15m bars for at most 60 days.
INTRADAY_PERIOD=30d

# --- Macro (FRED) ----------------------------------------------------------------
FRED_START=2000-01-01

# --- Fama-French factors (Kenneth French data library) --------------------------
FACTOR_START=2000-01-01

# --- SEC EDGAR -------------------------------------------------------------------
# REQUIRED by SEC fair-access policy: identify yourself with a name and email.
SEC_USER_AGENT=Your Name your.email@example.com
# 44 filings ~= 11 years of 10-K + 10-Q history per ticker (enough to backtest factor scores).
SEC_MAX_FILINGS=44

# --- News & sentiment ------------------------------------------------------------
NEWS_LOOKBACK_DAYS=7
# Window used to measure the price reaction after each headline.
NEWS_REACTION_MINUTES=60
SENTIMENT_MODEL=ProsusAI/finbert
# Set to false to skip the ~440 MB FinBERT download and use the lexicon fallback.
USE_FINBERT=true

HTTP_TIMEOUT=20
